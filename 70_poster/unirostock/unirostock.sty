%%%%%%%% Grundkommandos %%%%%%%%%%%%%%%%%
% eigenes Logo
\newcommand{\mylogo}{}
% Titel und Untertitel des Posters mit \title{xyz}, \subtitle{xyz}
\def\title#1{\def\p@stertitle{{#1}}}
\def\subtitle#1{\def\p@stersubtitle{{#1}}}
% Ueberschrift mit Box, vgl. S.61 im CD-Handbuch
\newlength\secb@xwidth
% Test auf gesternte Version von section, um Probleme mit thebiliography zu verhindern
\def\section#1{\postersection{#1}}
\WithSuffix\def\section*#1{\postersection{#1}}
\def\postersection#1{\setlength{\secb@xwidth}{\linewidth}
               \advance\secb@xwidth by -\columnsep
               \vspace{28.35pt}\hfil\begin{tikzpicture}
                                      \color{colorscheme}
                                      \draw (0, 0) node[color=colorscheme, fill=colorscheme, rounded corners=6.25mm]
                                            {
                                            \vspace*{0.3em}
                                            \begin{minipage}[t][][t]{\secb@xwidth}
                                              \begin{center}
                                                 \textcolor{white}{\arialnarrow{45}{60}{#1}}
                                              \end{center}
                                            \end{minipage}
                                            \vspace*{0.3em}
                                            };
                                   \end{tikzpicture}
                              \hfil\nobreak\par}

% Fliesstextueberschrift
\def\subsection#1{\vspace{28.35pt}\arialnarrow{25}{28.35}{\bf #1}\nobreak\\[28.35pt]}

% Standardspaltenzahl
\newcount\c@lumncount
\ifportrait\c@lumncount=2 \else\c@lumncount=4 \fi
% .. kann mit \columncount{x} geaendert werden
\def\columncount#1{\c@lumncount=#1}


% \addcontributor{Er}{a} zum Hinzufuegen eines Wissenschaftlers zur Fusszeile

\def\addcontributor#1#2{\@ifundefined{c@ntributors}{%
    \def\c@ntributors{#1\raisebox{12pt}{\arialnarrow{40}{30}{\hspace*{8pt}#2}}}}{%
    \g@addto@macro\c@ntributors{,\ #1\raisebox{12pt}{\arialnarrow{40}{30}{\hspace*{8pt}#2}}}}}


% \addinstitute{a}{Institut}{Lehrstuhl}{Fachbereich}{Universit\"at Rostock}{Musterstra{\ss}e 00}{18055 Rostock}{Germany} dito
\def\Institutet@ble{}
\def\addinstitute#1#2#3#4#5#6#7#8{\g@addto@macro\Institutet@ble{%
\raisebox{12pt}{\arialnarrow{40}{30}{#1\hspace*{8pt}}} &%
\edef\@temp{#2}\ifx\@temp\@empty{}\else\verd{40}{50}{\MakeUppercase{#2}}\@sep\fi%
\edef\@temp{#3}\ifx\@temp\@empty{}\else\verd{40}{50}{\MakeUppercase{#3}}\@sep\fi%
\edef\@temp{#4}\ifx\@temp\@empty{}\else\verd{40}{50}{\MakeUppercase{#4}}\@sep\fi%
\arialnarrow{40}{50}{\bf #5}%
\edef\@temp{#6}\ifx\@temp\@empty{}\else,\ \arialnarrow{40}{50}{#6}\fi%
\edef\@temp{#7}\ifx\@temp\@empty{}\else\@sep\arialnarrow{40}{50}{#7}\fi%
\edef\@temp{#8}\ifx\@temp\@empty{}\else,\ \arialnarrow{40}{50}{#8}\fi\\[-12pt]%

                                                                }}%
% erstellt die Institutstabelle in der Fusszeile
\def\m@kefooter{
  \begin{center}
    \parbox{\minip@gewidth}{
      \vbox to 97mm{
          \vfil
          \textcolor{white}{
          \arialnarrow{45}{60}{\bf \c@ntributors\\[20pt]}
          \setlength{\parskip}{0pt}         % Abstand nach Absatz
          \begin{tabular}{ll}
             \Institutet@ble
          \end{tabular}
          }\vfil}}
  \end{center}
}



