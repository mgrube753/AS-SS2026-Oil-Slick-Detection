%%%%%%%%%%%%% myfigure %%%%%%%%%%%%%%%%%%%
% Ersatz fuer figure, das in multicols nicht funktioniert
\setcounter{figure}{0}
\def\myfigure#1#2#3#4#5{\myfigureflex{\includegraphics[angle=#1,width=#3\linewidth]{#2}}{#4}{#5}}

%%%%%%%%%%%%% myfigureflex %%%%%%%%%%%%%%%%%%%
% Flexiblere Variante von myfigure
\def\myfigureflex#1#2#3{
\vspace{0.5cm}
\begin{minipage}{\linewidth}
\begin{center}
  #1\\
  \nobreak\medskip\relax
  % wenn #5 nicht leer ist: Caption setzen
  \def\w@testt{#3}\relax
  \ifx\w@testt\@empty{}\else{
                          \refstepcounter{figure}
                          % wenn #2 nicht leer ist: Label setzen
                          \edef\w@test{#2}\relax
                          \ifx\w@test\@empty{}\else\label{#2}\fi
                          \begin{minipage}{1.0\linewidth}
                            \begin{small}
                              {\sc \protect\figurename} \arabic{figure}: #3
                            \end{small}
                          \end{minipage}
                          \nobreak\medskip\relax
                            }
  \fi
\end{center}
\end{minipage}
}
