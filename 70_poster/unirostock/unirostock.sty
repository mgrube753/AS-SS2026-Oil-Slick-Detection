% eigenes Logo
\newcommand{\mylogo}{}
% Titel und Untertitel des Posters mit \title{xyz}, \subtitle{xyz}
\def\title#1{\def\p@stertitle{{#1}}}
\def\subtitle#1{\def\p@stersubtitle{{#1}}}
% Ueberschrift mit Box, vgl. S.61 im CD-Handbuch
\newlength\secb@xwidth
% Test auf gesternte Version von section, um Probleme mit thebiliography zu verhindern
\def\section#1{\postersection{#1}}
\WithSuffix\def\section*#1{\postersection{#1}}
\def\postersection#1{\setlength{\secb@xwidth}{\linewidth}
               \advance\secb@xwidth by -\columnsep
               \vspace{18pt}\hfil\begin{tikzpicture}
                                      \color{colorscheme}
                                      \draw (0, 0) node[color=colorscheme, fill=colorscheme, rounded corners=5mm]
                                            {
                                            \vspace*{0.2em}
                                            \begin{minipage}[t][][t]{\secb@xwidth}
                                              \begin{center}
                                                 \textcolor{white}{\arialnarrow{40}{50}{#1}}
                                              \end{center}
                                            \end{minipage}
                                            \vspace*{0.2em}
                                            };
                                   \end{tikzpicture}
                              \hfil\nobreak\par}

% Fliesstextueberschrift
\def\subsection#1{\vspace{14pt}\arialnarrow{26}{26}{\bf #1}\nobreak\\[12pt]}

% Standardspaltenzahl
