% \addcontributor{Er}{a} zum Hinzufuegen eines Wissenschaftlers zur Fusszeile

\def\addcontributor#1#2{\@ifundefined{c@ntributors}{%
    \def\c@ntributors{#1\raisebox{10pt}{\arialnarrow{30}{24}{\hspace*{6pt}#2}}}}{%
    \g@addto@macro\c@ntributors{,\ #1\raisebox{10pt}{\arialnarrow{30}{24}{\hspace*{6pt}#2}}}}}


% \addinstitute{a}{Institut}{Lehrstuhl}{Fachbereich}{Universit\"at Rostock}{Musterstra{\ss}e 00}{18055 Rostock}{Germany} dito
\def\Institutet@ble{}
\def\addinstitute#1#2#3#4#5#6#7#8{\g@addto@macro\Institutet@ble{%
\raisebox{10pt}{\arialnarrow{30}{24}{#1\hspace*{6pt}}} &%
\edef\@temp{#2}\ifx\@temp\@empty{}\else\verd{30}{38}{\MakeUppercase{#2}}\@sep\fi%
\edef\@temp{#3}\ifx\@temp\@empty{}\else\verd{30}{38}{\MakeUppercase{#3}}\@sep\fi%
\edef\@temp{#4}\ifx\@temp\@empty{}\else\verd{30}{38}{\MakeUppercase{#4}}\@sep\fi%
\arialnarrow{30}{38}{\bf #5}%
\edef\@temp{#6}\ifx\@temp\@empty{}\else,\ \arialnarrow{30}{38}{#6}\fi%
\edef\@temp{#7}\ifx\@temp\@empty{}\else\@sep\arialnarrow{30}{38}{#7}\fi%
\edef\@temp{#8}\ifx\@temp\@empty{}\else,\ \arialnarrow{30}{38}{#8}\fi\\[-10pt]%

                                                                }}%
